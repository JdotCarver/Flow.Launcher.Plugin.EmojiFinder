{
  "name": "flow.launcher.plugin.emojifinder",
  "version": "1.2.0",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "agent": "node tools/paste-agent.mjs",
    "build": "tsc",
    "check:paste-agent": "node tools/check-paste-agent.mjs",
    "benchmark": "node tools/bench.mjs",
    "diagnose": "node tools/diagnose.mjs",
    "doctor": "node tools/doctor.mjs",
    "dogfood:check": "node tools/check-dogfood.mjs",
    "lint": "eslint",
    "package": "npm run build && node tools/package.mjs",
    "paste:selftest": "node tools/paste-selftest.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "Flow Launcher",
    "Emoji",
    "Plugin"
  ],
  "author": "kalvn",
  "license": "MIT",
  "description": "Find emoji easily with Flow Launcher by typing keywords.",
  "devDependencies": {
    "@types/node": "^22.5.2",
    "eslint": "^9.10.0",
    "neostandard": "^0.12.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "emoji-unicode": "^2.0.1",
    "emojilib": "^4.0.2"
  }
}
