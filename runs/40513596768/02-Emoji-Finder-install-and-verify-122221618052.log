2026-10-27T13:38:21.3891508Z   Write-Host "--- $report ---"
2026-10-27T13:38:21.3891688Z   $json = Get-Content -LiteralPath $path -Raw | ConvertFrom-Json
2026-10-27T13:38:21.3892258Z   # Two report shapes: the paste check says ok=<bool>, the ranking check says
2026-10-27T13:38:21.3892529Z   # kind=pass/fail. Printing either with the wrong field name reports 22 passing
2026-10-27T13:38:21.3892816Z   # findings as failures, which is what the first version of this step did.
2026-10-27T13:38:21.3893044Z   $findings = if ($report -eq 'paste-agent-check.json') {
2026-10-27T13:38:21.3893260Z     foreach ($hostResult in $json.results) { $hostResult.findings }
