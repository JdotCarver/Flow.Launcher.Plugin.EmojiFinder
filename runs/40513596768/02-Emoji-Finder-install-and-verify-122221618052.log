2026-10-27T13:38:21.3893535Z     $json.findings
2026-10-27T13:38:21.3893637Z   }
2026-10-27T13:38:21.3893736Z   foreach ($finding in $findings) {
2026-10-27T13:38:21.3893963Z     $passed = if ($null -ne $finding.ok) { [bool]$finding.ok } else { $finding.kind -eq 'pass' }
2026-10-27T13:38:21.3894325Z     $detail = if ($finding.detail) { " - $($finding.detail)" } elseif ($finding.message) { " - $($finding.message)" } else { '' }
2026-10-27T13:38:21.3894667Z     Write-Host ("  {0} {1}{2}" -f $(if ($passed) { 'ok  ' } else { 'FAIL' }), $finding.label, $detail)
2026-10-27T13:38:21.3894861Z   }
2026-10-27T13:38:21.3894944Z }
